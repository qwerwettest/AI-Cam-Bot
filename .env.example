# ==================== Telegram ====================
TELEGRAM_BOT_TOKEN=123456789:AAAA_BBBBB_CCCCC_DDDDD

# ==================== Java API ====================
# Адрес Java-сервера (репозиторий AI-Cam)
JAVA_BASE_URL=http://localhost:3333

# Пути к эндпоинтам Java. Обязателен только "bridge".
# Если переменную не задать, используется {"bridge": "/api/bridge"}.
JAVA_API_PATHS={"bridge":"/api/bridge"}

# Авторизация между ботом и Java: none | api_key | bearer | basic
JAVA_AUTH_SCHEME=none
JAVA_AUTH_SECRET=
JAVA_API_KEY_HEADER=X-API-Key

# ==================== Доменные данные ====================
# Список локаций для меню выбора.
# id должен совпадать с ключами LOCATION_TO_CORPUS в Java (BotBridgeService).
LOCATIONS_LIST=[{"id":"corp_a","name":"Корпус А","floors":[1,2,3]},{"id":"corp_b","name":"Корпус Б","floors":[1,2,3]},{"id":"corp_c","name":"Корпус С","floors":[1,2,3]}]

# Варианты длительности и частых времён начала
SEARCH_FILTERS={"duration_options":[30,60,90,120],"common_times":["08:00","09:30","11:00","12:40","14:00","15:30","17:00"]}

# Админы: через запятую (111,222) или JSON-массивом ([111,222])
ADMIN_TELEGRAM_IDS=

# ==================== Runtime ====================
REQUEST_TIMEOUT_SECONDS=8
MAX_RETRIES=3
RETRY_BACKOFF_BASE=0.6
STORAGE_PATH=data/users.json
LOG_PATH=logs/bot.log
LOG_LEVEL=INFO
